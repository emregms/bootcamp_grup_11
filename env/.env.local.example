# ================================================================
# SkillBridge — Ortam Değişkenleri Şablonu
# Domain: https://skillbridge.hegg.tr
#
# Kurulum: cp env/.env.local.example .env.local
# ================================================================

# --- Supabase (zorunlu) ---
NEXT_PUBLIC_SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJ...your-anon-key
SUPABASE_SERVICE_ROLE_KEY=eyJ...your-service-role-key

# --- Uygulama (production) ---
NEXT_PUBLIC_APP_URL=https://skillbridge.hegg.tr
NEXT_PUBLIC_APP_NAME=SkillBridge
NEXT_PUBLIC_AUTH_REDIRECT_URL=https://skillbridge.hegg.tr/auth/callback

# --- Google Gemini AI ---
GEMINI_API_KEY=your-gemini-api-key
GEMINI_MODEL=gemini-2.0-flash-lite
# Kota bittiğinde veya yarışma demosu için true yapın (Gemini çağrılmaz)
GEMINI_USE_FALLBACK=false

# --- Yerel geliştirme (npm run dev) ---
# NEXT_PUBLIC_APP_URL=http://localhost:3000
# NEXT_PUBLIC_AUTH_REDIRECT_URL=http://localhost:3000/auth/callback

# --- Supabase Auth URL ayarları ---
# Site URL: https://skillbridge.hegg.tr
# Redirect URLs:
#   https://skillbridge.hegg.tr/auth/callback
#   http://localhost:3000/auth/callback
