# Production deploy — Coolify / Docker (skillbridge.hegg.tr)
# Runtime env: Coolify → Environment Variables
# Build-time (Build Arguments): NEXT_PUBLIC_* değişkenleri

NEXT_PUBLIC_SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJ...your-anon-key
SUPABASE_SERVICE_ROLE_KEY=eyJ...your-service-role-key

NEXT_PUBLIC_APP_URL=https://skillbridge.hegg.tr
NEXT_PUBLIC_APP_NAME=SkillBridge
NEXT_PUBLIC_AUTH_REDIRECT_URL=https://skillbridge.hegg.tr/auth/callback

GEMINI_API_KEY=your-gemini-api-key
GEMINI_MODEL=gemini-2.0-flash
